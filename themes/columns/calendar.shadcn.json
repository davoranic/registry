      "action": "oklch(0 0 0)",
      "on-action": "oklch(0.985 0 0)",
      "interaction-hover": "oklch(0.97 0 0)",
      "focus": "oklch(0.708 0 0)",
      "radius-control": "calc(0.625rem - 2px)",
      "radius-container": "0.625rem",
      "type-body": "400 14px/20px ui-sans-serif, system-ui, sans-serif",
      "type-label": "500 14px/20px ui-sans-serif, system-ui, sans-serif",
      "type-caption": "400 12.8px/16px ui-sans-serif, system-ui, sans-serif",
      "control-size": "2rem",
      "inset": "12px",
      "cursor-interactive": "default",
      "cursor-disabled": "default",
      "focus-width": "3px"
    },
    "dark": {
      "surface": "oklch(0.145 0 0)",
      "on-surface": "oklch(0.985 0 0)",
      "content-secondary": "oklch(0.708 0 0)",
      "action": "oklch(0.922 0 0)",
      "on-action": "oklch(0.205 0 0)",
      "interaction-hover": "oklch(0.371 0 0)",
      "focus": "oklch(0.556 0 0)"
    }
  },
  "provenance": {
    "surface": "ui/apps/v4/app/globals.css :root --background / .dark --background",
    "on-surface": "--foreground light oklch(0% 0 0) / dark oklch(0.985 0 0)",
    "content-secondary": "--muted-foreground",
    "action": "--primary (this checkout: pure black light / oklch 0.922 dark)",
    "interaction-hover": "--accent",
    "focus": "--ring",
    "radius-control": "--radius 0.625rem; rounded-md = radius - 2px (globals.css @theme)",
    "type-body": "text-sm 14px; family: source uses Geist via next/font \u2014 NOT downloaded; system-ui stack substituted (declared substitution)",
    "control-size": "calendar.tsx --cell-size: --spacing(8) = 2rem",
    "cursor-interactive": "shadcn v4 buttons use default cursor (no pointer) \u2014 character detail, kept"
  },
