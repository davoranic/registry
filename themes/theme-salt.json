{
  "$schema": "./theme.schema.json",
  "name": "salt",
  "title": "Salt DS",
  "description": "JPMorgan Salt character: sharp corners, Salt blue actions, Open Sans, uppercase action text, density-scaled rhythm. Derived from @salt-ds/theme (clone: salt-ds/packages/theme).",
  "capabilities": {
    "modes": [
      "light",
      "dark"
    ],
    "density": {
      "options": [
        "high",
        "medium",
        "low",
        "touch"
      ],
      "default": "medium"
    },
    "corner": "fixed-sharp",
    "iconSets": {
      "default": "salt",
      "options": [
        "salt",
        "lucide",
        "tabler",
        "radix"
      ],
      "mechanism": "SemanticIconProvider \u2014 33 semantic slots (CloseIcon, ChevronDownIcon, CalendarIcon, \u2026), each accepts any React icon component; components resolve icons by ROLE, not by import"
    },
    "fonts": [
      "open-sans"
    ]
  },
  "constraints": [
    "Radius is NOT a knob \u2014 Salt is sharp (0) everywhere except pills (999px).",
    "Density rescales control heights, spacing, text and icon size together.",
    "Actions are uppercase 600 with 0.6px tracking \u2014 not configurable.",
    "Default icon set is Salt's own 12px first-party set (~548 icons; 62 SVGs mirrored in themes/salt/assets). Swapping is per semantic role via SemanticIconProvider, not per-import like shadcn's migrate."
  ],
  "tokens": {
    "light": {
      "surface": "#FFFFFF",
      "on-surface": "#161616",
      "surface-raised": "#FFFFFF",
      "on-surface-raised": "#161616",
      "surface-overlay": "#FFFFFF",
      "on-surface-overlay": "#161616",
      "action": "#155C93",
      "on-action": "#FFFFFF",
      "action-secondary": "#EAEDEF",
      "on-action-secondary": "#161616",
      "surface-sunken": "#EAEDEF",
      "content-secondary": "#61656E",
      "interaction-hover": "#CBE7F9",
      "on-interaction-selected": "#161616",
      "status-critical": "#C42010",
      "status-success": "#18723D",
      "status-warning": "#CC440D",
      "border": "#CED2D9",
      "field-border": "#61656E",
      "focus": "#155C93"
    },
    "dark": {
      "surface": "#242526",
      "on-surface": "#FFFFFF",
      "surface-raised": "#2A2C2F",
      "on-surface-raised": "#FFFFFF",
      "surface-overlay": "#2A2C2F",
      "on-surface-overlay": "#FFFFFF",
      "action": "#2670A9",
      "on-action": "#FFFFFF",
      "action-secondary": "#2F3136",
      "on-action-secondary": "#FFFFFF",
      "surface-sunken": "#2F3136",
      "content-secondary": "#B4B7BE",
      "interaction-hover": "#1A2A38",
      "on-interaction-selected": "#FFFFFF",
      "status-critical": "#FF5942",
      "status-success": "#24874B",
      "status-warning": "#EA7319",
      "border": "#4C505B",
      "field-border": "#B4B7BE",
      "focus": "#4B9FD8"
    },
    "shape": {
      "radius": "0rem"
    },
    "rhythm": {
      "byDensity": {
        "high": {
          "spacing": "0.125rem",
          "control-h": "1.25rem",
          "control-px": "0.5rem",
          "text-ui": "0.6875rem",
          "icon-size": "0.625rem"
        },
        "medium": {
          "spacing": "0.25rem",
          "control-h": "1.75rem",
          "control-px": "0.75rem",
          "text-ui": "0.75rem",
          "icon-size": "0.75rem"
        },
        "low": {
          "spacing": "0.375rem",
          "control-h": "2.25rem",
          "control-px": "1rem",
          "text-ui": "0.875rem",
          "icon-size": "0.875rem"
        },
        "touch": {
          "spacing": "0.5rem",
          "control-h": "2.75rem",
          "control-px": "1.25rem",
          "text-ui": "0.875rem",
          "icon-size": "1rem"
        }
      }
    },
    "type": {
      "font-sans": "'Open Sans', -apple-system, system-ui, sans-serif",
      "ui-weight": "600",
      "ui-case": "uppercase",
      "ui-tracking": "0.6px"
    },
    "focus": {
      "focus-width": "2px",
      "focus-style": "outline",
      "focus-offset": "2px"
    },
    "growth-1.2.0": {
      "cursor-interactive": "pointer",
      "cursor-disabled": "not-allowed",
      "cursor-busy": "progress",
      "cursor-grab": "grab",
      "border-style-emphasis": "dashed",
      "link-decoration": "underline",
      "size-overlay": {
        "rule": "density-scaled; medium \u2248 24/32/40rem"
      },
      "source": "salt foundations cursor.css (10 cursors) + borderStyle.css"
    },
    "growth-1.1.0": {
      "border-subtle": {
        "light": "#E6E6E6",
        "dark": "#38383A",
        "source": "separable-tertiary"
      },
      "field-surface": {
        "light": "#FFFFFF",
        "dark": "#2A2C2F",
        "source": "editable-primary-background"
      },
      "field-surface-hover": {
        "light": "#F2F4F6",
        "dark": "#2F3136",
        "source": "editable hover"
      },
      "field-border-hover": {
        "light": "#155C93",
        "dark": "#4B9FD8",
        "source": "editable-borderColor-hover"
      },
      "field-border-active": {
        "light": "#155C93",
        "dark": "#4B9FD8",
        "source": "editable-borderColor-active"
      },
      "content-disabled": {
        "rule": "explicit 40% (Salt disabled alpha)",
        "source": "content characteristic"
      },
      "selected-indicator": {
        "light": "#155C93",
        "dark": "#4B9FD8",
        "source": "navigable-accent-indicator-active"
      },
      "target-surface-hover": {
        "light": "#EAF4FB",
        "dark": "#1A2A38",
        "source": "target-background-hover"
      },
      "target-border-hover": {
        "light": "#2670A9",
        "dark": "#4B9FD8",
        "source": "target-borderColor-hover"
      },
      "data-7..12": {
        "rule": "Salt categorical ramp cobalt/cider/plum/aqua/slate/rose (600 step)",
        "source": "category characteristic (100 tokens; 20 series supported)"
      }
    },
    "status": {
      "info": {
        "base": "#155C93",
        "surface": "#EAF4FB",
        "border": "#2670A9",
        "on": "#FFFFFF"
      },
      "success": {
        "base": "#18723D",
        "surface": "#E9F5EC",
        "border": "#24874B",
        "on": "#FFFFFF"
      },
      "warning": {
        "base": "#CC440D",
        "surface": "#FFE8BF",
        "border": "#D65513",
        "on": "#FFFFFF"
      },
      "critical": {
        "base": "#C42010",
        "surface": "#FFE3E0",
        "border": "#E32B16",
        "on": "#FFFFFF"
      }
    },
    "elevation": {
      "strategy": "border",
      "resting": "none \u2014 1px #CED2D9 border",
      "raised": "0 1px 3px 0 rgba(0,0,0,0.10)",
      "overlay": "0 4px 8px 0 rgba(0,0,0,0.15)",
      "modal": "0 12px 40px 0 rgba(0,0,0,0.30)",
      "source": "salt-ds/packages/theme css/foundations + palette/shadow"
    },
    "motion": {
      "duration": {
        "instant": "0ms",
        "fast": "150ms",
        "base": "300ms",
        "slow": "1000ms"
      },
      "easing": {
        "standard": "ease-in-out",
        "enter": "ease-out",
        "exit": "ease-in",
        "emphasized": "ease-in-out"
      },
      "source": "salt duration foundation: instant 0 / perceptible 300 / notable 1000 / cutoff 10000"
    },
    "layers": {
      "base": 1,
      "sticky": 1100,
      "dropdown": 1000,
      "overlay": 1200,
      "modal": 1300,
      "notification": 1400,
      "tooltip": 1500,
      "source": "salt zindex foundation (appHeader=1100, drawer=1200, flyover=1500)"
    },
    "typeRoles": {
      "action": {
        "weight": "600",
        "case": "uppercase",
        "tracking": "0.6px"
      },
      "heading": "600 Open Sans (display tiers: Amplitude, licensed)",
      "label": "600 11px",
      "data": "PT Mono tabular"
    },
    "iconRoles": {
      "mechanism": "provider (SemanticIconProvider, 33 slots)",
      "close": "CloseIcon",
      "dismiss": "CloseIcon",
      "expand": "ChevronDownIcon",
      "collapse": "ChevronUpIcon",
      "back": "ChevronLeftIcon",
      "forward": "ChevronRightIcon",
      "search": "SearchIcon",
      "add": "AddIcon",
      "remove": "RemoveIcon",
      "overflow": "OverflowMenuIcon",
      "error": "ErrorSolidIcon",
      "warning": "WarningSolidIcon",
      "success": "SuccessCircleSolidIcon",
      "info": "InfoSolidIcon",
      "calendar": "CalendarIcon",
      "user": "UserIcon",
      "upload": "UploadIcon",
      "external": "TearOutIcon",
      "drag": "DragRowIcon",
      "loading": "ProgressInprogressIcon"
    }
  },
  "anatomySpecific": [
    "stepper",
    "rating",
    "tree",
    "toggletip",
    "scrim",
    "segmented-button-group",
    "flush-input (bottom-border input treatment)",
    "density provider"
  ],
  "variantMaps": {
    "button": {
      "emphasis:primary+prominence:solid": "sentiment=accented appearance=solid",
      "emphasis:secondary+prominence:solid": "sentiment=neutral appearance=solid",
      "emphasis:danger+prominence:solid": "sentiment=negative appearance=solid",
      "emphasis:primary+prominence:outline": "sentiment=accented appearance=bordered",
      "emphasis:secondary+prominence:ghost": "sentiment=neutral appearance=transparent",
      "emphasis:danger+prominence:ghost": "sentiment=negative appearance=transparent",
      "fallbacks": {
        "emphasis:primary+prominence:link": "render as Link component (link color, no action case)"
      },
      "emphasis:secondary+prominence:outline": "sentiment=neutral appearance=bordered"
    },
    "badge": {
      "tone:*": "status-<tone>-surface + status-<tone> (pill anatomy, radius-pill)",
      "neutral": "pill neutral (surface-sunken)"
    }
  }
}