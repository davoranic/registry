        "weight": "400",
        "case": "none",
        "tracking": "0em"
      },
      "code": {
        "tailwind": "font-mono text-[0.8125rem]",
        "font": "400 0.8125rem/1.25rem var(--family-code)",
        "weight": "400",
        "case": "none",
        "tracking": "0em"
      },
      "data": {
        "tailwind": "font-mono text-sm tabular-nums",
        "font": "400 0.875rem/1.25rem var(--family-code)",
        "weight": "400",
        "case": "none",
        "tracking": "0em"
      }
    },
    "iconRoles": {
      "mechanism": "import",
      "close": "XIcon",
      "dismiss": "XIcon",
      "expand": "ChevronDownIcon",
      "collapse": "ChevronUpIcon",
      "back": "ChevronLeftIcon",
      "forward": "ChevronRightIcon",
      "search": "SearchIcon",
      "add": "PlusIcon",
      "remove": "MinusIcon",
      "overflow": "MoreHorizontalIcon",
      "error": "OctagonXIcon",
      "warning": "TriangleAlertIcon",
      "success": "CircleCheckIcon",
      "info": "InfoIcon",
      "calendar": "CalendarIcon",
      "user": "UserIcon",
      "upload": "UploadIcon",
      "external": "ExternalLinkIcon",
      "drag": "GripVerticalIcon",
      "loading": "Loader2Icon"
    }
  },
  "variantMaps": {
    "button": {
      "emphasis:primary+prominence:solid": "variant=default",
      "emphasis:secondary+prominence:solid": "variant=secondary",
      "emphasis:danger+prominence:solid": "variant=destructive",
      "emphasis:secondary+prominence:ghost": "variant=ghost",
      "emphasis:primary+prominence:link": "variant=link",
      "fallbacks": {
        "emphasis:danger+prominence:ghost": "compose: ghost + status-critical text",
        "emphasis:primary+prominence:outline": "compose: outline + action-colored border/text"
      },
      "emphasis:secondary+prominence:outline": "variant=outline"
    },
    "badge": {
      "tone:info": "status-info-surface + status-info",
      "tone:success": "status-success-surface + status-success",
      "tone:warning": "status-warning-surface + status-warning",
      "tone:critical": "status-critical-surface + status-critical",
      "neutral": "variant=secondary"
    }
  }
}
