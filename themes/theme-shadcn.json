      "action-active": "oklch(0.145 0 0)",
      "action-secondary": "oklch(0.97 0 0)",
      "on-action-secondary": "oklch(0.205 0 0)",
      "surface-sunken": "oklch(0.97 0 0)",
      "content-secondary": "oklch(0.556 0 0)",
      "interaction-hover": "oklch(0.97 0 0)",
      "interaction-active": "oklch(0.922 0 0)",
      "interaction-selected": "oklch(0.97 0 0)",
      "on-interaction-selected": "oklch(0.205 0 0)",
      "status-critical": "oklch(0.577 0.245 27.325)",
      "status-success": "oklch(0.627 0.17 149.2)",
      "status-warning": "oklch(0.666 0.179 58.3)",
      "border": "oklch(0.922 0 0)",
      "border-strong": "oklch(0.708 0 0)",
      "field-border": "oklch(0.922 0 0)",
      "link": "oklch(0.205 0 0)",
      "focus": "oklch(0.708 0 0)",
      "overlay-scrim": "oklch(0 0 0 / 50%)",
      "inverse-surface": "oklch(0.205 0 0)",
      "on-inverse-surface": "oklch(0.985 0 0)",
      "data-1": "oklch(0.646 0.222 41.116)",
      "data-2": "oklch(0.6 0.118 184.704)",
      "data-3": "oklch(0.398 0.07 227.392)",
      "data-4": "oklch(0.828 0.189 84.429)",
      "data-5": "oklch(0.769 0.188 70.08)",
