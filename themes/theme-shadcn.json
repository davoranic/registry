      "interaction-active": "oklch(0.439 0 0)",
      "interaction-selected": "oklch(0.371 0 0)",
      "on-interaction-selected": "oklch(0.985 0 0)",
      "status-critical": "oklch(0.704 0.191 22.216)",
      "status-success": "oklch(0.723 0.192 149.6)",
      "status-warning": "oklch(0.769 0.188 70.1)",
      "border": "oklch(1 0 0 / 10%)",
      "border-strong": "oklch(0.556 0 0)",
      "field-border": "oklch(1 0 0 / 15%)",
      "link": "oklch(0.985 0 0)",
      "focus": "oklch(0.556 0 0)",
      "overlay-scrim": "oklch(0 0 0 / 80%)",
      "inverse-surface": "oklch(0.985 0 0)",
      "on-inverse-surface": "oklch(0.145 0 0)",
      "data-1": "oklch(0.488 0.243 264.376)",
      "data-2": "oklch(0.696 0.17 162.48)",
      "data-3": "oklch(0.769 0.188 70.08)",
      "data-4": "oklch(0.627 0.265 303.9)",
      "data-5": "oklch(0.645 0.246 16.439)",
      "data-6": "oklch(0.6 0.118 184.704)",
      "data-7": "oklch(0.65 0.2 20)",
      "data-8": "oklch(0.7 0.16 130)",
      "data-9": "oklch(0.6 0.16 280)",
