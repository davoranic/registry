{
  "$schema": "./theme.schema.json",
  "name": "shadcn",
  "title": "shadcn neutral",
  "description": "The default character: neutral oklch, soft radius, system sans, quiet shadows.",
  "sourceRef": "shadcn-ui/ui — registry/new-york-v4 base tokens + tailwind v4 theme layer",
  "sources": {
    "color": "shadcn/ui base 'neutral' oklch token set (globals.css :root / .dark)",
    "data": "--chart-1..5 from the same base set; 6..12 are a declared hue-rotated extension",
    "typography": "tailwind text-* scale (text-4xl…text-xs) as used by the shipped components",
    "space": "tailwind 4px spacing grid (--spacing: 0.25rem)",
    "shape": "tailwind v4 radius ladder: --radius-sm/md/lg/xl derived from the --radius knob",
    "elevation": "tailwind shadow-xs/sm/md/lg",
    "motion": "tailwind + tw-animate-css defaults",
    "icons": "lucide-react at size-4 (control), size-3 (inline), size-6 (emphasis), stroke 2"
  },
  "capabilities": {
    "modes": [
      "light",
      "dark"
    ],
    "density": false,
    "corner": "knob",
    "iconSets": [
      "lucide",
      "tabler",
      "radix"
    ],
    "fonts": [
      "system",
      "geist"
    ]
  },
  "constraints": [
    "No density switching — the scale is fixed to the 4px grid.",
    "Radius is a free knob (--radius); all derived radii follow.",
    "No dedicated inverse surface — inverse-* is the opposite mode's surface pair.",
    "Fields are transparent-filled: field-surface tracks surface and does not change on hover."
  ],
  "tokens": {
