{
  "$schema": "../anatomy.schema.json",
  "name": "select",
  "behavior": "APG combobox/listbox pattern (Alt+Down opens; typeahead; Esc dismisses; roving focus in listbox)",
  "parts": [
    { "part": "root", "tokens": ["field-border", "surface", "on-surface", "radius-control", "control-height-md", "inset-control-x", "type-label", "focus"] },
    { "part": "value", "contentSlot": true, "tokens": ["type-label", "content-secondary"] },
    { "part": "indicator", "iconRole": "expand", "tokens": ["icon-size-control"], "statesNote": "rotates 180deg on open at duration-fast" },
    { "part": "listbox", "tokens": ["surface-overlay", "on-surface-overlay", "border", "radius-overlay", "elevation-overlay", "layer-dropdown"] },
    { "part": "option", "tokens": ["type-label", "interaction-hover", "interaction-selected", "space-inline-md"] },
    { "part": "option-indicator", "iconRole": "success", "tokens": ["icon-size-inline"], "note": "checkmark on selected option" },
    { "part": "group-label", "optional": true, "tokens": ["type-caption", "content-secondary"] }
  ],
  "variantAxes": { "size": ["sm", "md", "lg"] },
  "states": ["rest", "hover", "focus-visible", "disabled", "invalid", "open"],
  "anatomyNotes": "Parts are invariant across themes. Salt's flush (bottom-border-only) trigger is a RECIPE difference on the root part (field-border applied to border-bottom only) — not different anatomy.",
  "motion": { "listbox-enter": { "duration": "duration-fast", "easing": "easing-enter" }, "listbox-exit": { "duration": "duration-instant", "easing": "easing-exit" } }
}
