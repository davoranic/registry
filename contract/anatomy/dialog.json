{
  "$schema": "../anatomy.schema.json",
  "name": "dialog",
  "behavior": "APG dialog (modal) pattern (focus trapped in panel; Tab cycles; Esc closes; focus returns to trigger on close; aria-modal=true; labelled by title, described by description)",
  "parts": [
    { "part": "scrim", "tokens": ["overlay-scrim", "layer-modal"] },
    { "part": "panel", "tokens": ["surface-overlay", "on-surface-overlay", "border", "radius-overlay", "elevation-modal", "layer-modal", "inset-container", "size-overlay-md"] },
    { "part": "header", "tokens": ["space-stack-sm"] },
    { "part": "title", "contentSlot": true, "tokens": ["type-heading-3", "on-surface-overlay"] },
    { "part": "description", "contentSlot": true, "optional": true, "tokens": ["type-body", "content-secondary"] },
    { "part": "content", "contentSlot": true, "tokens": ["type-body", "space-stack-md"] },
    { "part": "footer", "tokens": ["space-inline-md"], "note": "action slot — hosts buttons (anatomy/button.json); end-aligned, stacks vertically on narrow viewports" },
    { "part": "close", "optional": true, "iconRole": "close", "tokens": ["icon-size-control", "interaction-hover", "radius-control", "focus"] }
  ],
  "variantAxes": { "size": ["sm", "md", "lg"] },
  "states": ["rest", "open"],
  "anatomyNotes": "Dialog's size axis binds to the size-overlay-* width ramp, not control-height-*. Salt splits header/actions into subcomponents and shadcn uses data-slots — same parts either way.",
  "motion": { "panel-enter": { "duration": "duration-base", "easing": "easing-enter" }, "panel-exit": { "duration": "duration-fast", "easing": "easing-exit" }, "scrim-fade": { "duration": "duration-base", "easing": "easing-standard" } }
}
