{
  "$schema": "../anatomy.schema.json",
  "name": "button",
  "behavior": "APG button pattern (Enter/Space activate; button role implicit)",
  "parts": [
    { "part": "root", "tokens": ["action", "on-action", "radius-control", "type-action", "action-case", "action-tracking", "control-height-md", "inset-control-x", "elevation-resting", "focus", "duration-fast", "easing-standard"] },
    { "part": "icon-leading", "optional": true, "tokens": ["icon-size-control", "space-inline-md"] },
    { "part": "label", "contentSlot": true, "tokens": ["type-action"] },
    { "part": "icon-trailing", "optional": true, "tokens": ["icon-size-control", "space-inline-md"] },
    { "part": "loading-indicator", "optional": true, "iconRole": "loading", "tokens": ["icon-size-control", "duration-slow"] }
  ],
  "variantAxes": { "emphasis": ["primary", "secondary", "danger"], "prominence": ["solid", "outline", "ghost", "link"], "size": ["sm", "md", "lg"] },
  "states": ["rest", "hover", "active", "focus-visible", "disabled", "loading"],
  "motion": { "state-transitions": { "duration": "duration-fast", "easing": "easing-standard" } }
}
