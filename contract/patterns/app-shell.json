{
  "name": "app-shell",
  "intent": "The persistent frame: navigation rail, header bar, content region.",
  "regions": [
    { "region": "nav", "order": 1, "width": "16rem", "surface": "surface-sunken", "components": [
      { "component": "nav-item", "contentSlots": { "label": "Dashboard" }, "state": "selected" },
      { "component": "nav-item", "contentSlots": { "label": "Invoices" } },
      { "component": "nav-item", "contentSlots": { "label": "Customers" } },
      { "component": "nav-item", "contentSlots": { "label": "Settings" } }
    ] },
    { "region": "header", "order": 2, "surface": "surface", "components": [
      { "component": "breadcrumb", "contentSlots": { "trail": "Home / Dashboard" } },
      { "component": "avatar", "contentSlots": { "fallback": "DA" }, "align": "end" }
    ] },
    { "region": "content", "order": 3, "surface": "surface", "contentSlots": { "placeholder": "pattern-slot: any pattern renders here" } }
  ],
  "layout": { "flow": "shell", "nav-edge": "start",
    "notes": "nav uses selected-indicator on the active item; header separated by border-subtle; content inset inset-container" },
  "responsive": [ { "below": "md", "change": "nav collapses to drawer (edge start)" } ],
  "a11y": [ "nav landmark + main landmark", "selected nav item aria-current=page" ]
}
