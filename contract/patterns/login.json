{
  "name": "login",
  "intent": "Authenticate a returning user with email and password.",
  "regions": [
    { "region": "brand", "order": 1, "contentSlots": { "headline": "Welcome back", "supporting": "Log in to your account to continue." } },
    { "region": "form", "order": 2, "components": [
      { "component": "field", "contentSlots": { "label": "Email" },
        "children": [ { "component": "input", "props": { "type": "email", "placeholder": "m@example.com" } } ] },
      { "component": "field", "contentSlots": { "label": "Password", "meta-link": "Forgot password?" },
        "children": [ { "component": "input", "props": { "type": "password" } } ] }
    ] },
    { "region": "actions", "order": 3, "components": [
      { "component": "button", "variants": { "emphasis": "primary", "prominence": "solid" }, "contentSlots": { "label": "Log in" }, "width": "fill" },
      { "component": "button", "variants": { "emphasis": "secondary", "prominence": "outline" }, "contentSlots": { "label": "Continue with SSO" }, "width": "fill" }
    ] },
    { "region": "meta", "order": 4, "contentSlots": { "prompt": "No account? Create one." } }
  ],
  "layout": { "flow": "stack", "gap": "space-stack-md", "max": "24rem",
    "container": { "surface": "surface-raised", "elevation": "elevation-raised", "radius": "radius-container", "inset": "inset-container" } },
  "responsive": [ { "below": "sm", "change": "container full-bleed on surface; inset halves" } ],
  "a11y": [ "form landmark", "headline is heading-2", "meta-link reachable after password field" ]
}
