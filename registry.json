{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "davoranic",
  "homepage": "https://github.com/davoranic/registry",
  "items": [
    {
      "name": "status-pill",
      "type": "registry:ui",
      "title": "Status Pill",
      "description": "A pill-shaped status indicator with sentiment variants (neutral, info, success, warning, destructive) and an optional status dot. Adds success/warning theme tokens.",
      "files": [
        {
          "path": "registry/status-pill/status-pill.tsx",
          "type": "registry:ui",
          "target": "components/ui/status-pill.tsx"
        }
      ],
      "cssVars": {
        "theme": {
          "color-success": "var(--success)",
          "color-success-foreground": "var(--success-foreground)",
          "color-warning": "var(--warning)",
          "color-warning-foreground": "var(--warning-foreground)"
        },
        "light": {
          "success": "oklch(0.627 0.17 149.2)",
          "success-foreground": "oklch(0.982 0.018 155.8)",
          "warning": "oklch(0.666 0.179 58.3)",
          "warning-foreground": "oklch(0.987 0.022 95.3)"
        },
        "dark": {
          "success": "oklch(0.723 0.192 149.6)",
          "success-foreground": "oklch(0.266 0.065 152.9)",
          "warning": "oklch(0.769 0.188 70.1)",
          "warning-foreground": "oklch(0.279 0.077 45.6)"
        }
      }
    }
  ]
}
