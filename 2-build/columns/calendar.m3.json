{
  "system": "m3",
  "component": "calendar",
  "fontFaces": [
    {
      "family": "Roboto",
      "weight": "400",
      "file": "fonts/roboto-400.woff2"
    },
    {
      "family": "Roboto",
      "weight": "500",
      "file": "fonts/roboto-500.woff2"
    }
  ],
  "slots": {
    "light": {
      "surface": "#fef7ff",
      "on-surface": "#1d1b20",
      "content-secondary": "#49454f",
      "action": "#6750a4",
      "on-action": "#ffffff",
      "focus": "#6750a4",
      "interaction-hover": "color-mix(in srgb, #49454f 8%, transparent)",
      "x-m3-surface-container-high": "#ece6f0",
      "x-m3-on-surface-variant": "#49454f",
      "type-body": "400 16px/24px Roboto, sans-serif",
      "type-label": "500 14px/20px Roboto, sans-serif",
      "type-headline": "400 32px/40px Roboto, sans-serif",
      "control-size": "40px",
      "inset": "12px",
      "cursor-interactive": "pointer",
      "cursor-disabled": "not-allowed",
      "focus-width": "3px"
    },
    "dark": {
      "surface": "#141218",
      "on-surface": "#e6e0e9",
      "content-secondary": "#cac4d0",
      "action": "#d0bcff",
      "on-action": "#381e72",
      "focus": "#d0bcff",
      "interaction-hover": "color-mix(in srgb, #cac4d0 8%, transparent)",
      "x-m3-surface-container-high": "#2b2930",
      "x-m3-on-surface-variant": "#cac4d0"
    }
  },
  "provenance": {
    "edition-pin": "tokens/versions/v0_192. OWNER DECISION: every M3 column pins the v0.192 edition, because material-web's own hand-authored wrappers @use versions/v0_192. This column was ALREADY on v0.192 (see the surface-container-high entry below), so the decision changes nothing here. Re-verified under the pin: versions/v0_192/_md-comp-date-picker-{docked,modal}.scss and _md-comp-date-input-modal.scss all exist in this edition; _md-sys-typescale.scss, _md-sys-shape.scss and _md-ref-palette.scss are value-identical to `latest`. The focus values below (0.12 state layer, 3px ring) are the v0.192 numbers.",
    "focus-slot-role-flag": "REPORTED, NOT EDITED. The `focus` entry below says 'md-focus-ring 3px primary', but tokens/_md-comp-focus-ring.scss carries $color: md-sys-color.secondary, not primary. The discrepancy is edition-INDEPENDENT (identical in v0.192 and latest) and therefore not a consequence of this pin, so no colour slot value was changed. Flagged for the owner.",
    "x-m3-surface-container-high": "material-web tokens/versions/v0_192: sys surface-container-high -> ref neutral92 #ece6f0 / neutral17 #2b2930",
    "surface": "sys surface -> neutral98 #fef7ff / neutral6 #141218 (dark from baseline scheme)",
    "on-surface": "ref neutral10 #1d1b20 / neutral90 #e6e0e9",
    "content-secondary": "on-surface-variant -> neutral-variant30 #49454f / neutral-variant80 #cac4d0",
    "action": "sys primary -> primary40 #6750a4 / primary80 #d0bcff",
    "on-action": "on-primary -> primary100 #fff / primary20 #381e72",
    "interaction-hover": "date-unselected-hover-state-layer-color on-surface-variant x hover-state-layer-opacity 0.08 (_md-sys-state.scss)",
    "type-body": "typescale body-large 16/24 w400 Roboto (date + weekday labels per docked tokens)",
    "type-headline": "typescale headline-large 32/40 (modal header selected date)",
    "type-label": "typescale label-large 14/20 w500 (menu button, actions)",
    "control-size": "date-state-layer-width/height 40px (visible circle; cell is 48px via cell-padding)",
    "focus": "focus-state-layer 0.12 + md-focus-ring 3px primary"
  },
  "cells": {
    "structure.nav.variant": {
      "kind": "value",
      "value": "month-menu",
      "source": "docked tokens menu-button-*; m3.material.io date picker: 'August 2025 v' menu + chevrons",
      "note": "COMPOSITION PLACEHOLDER: M3's month menu is registry component 'menu-button'+'menu' (m3 comp tokens menu-button-*, menu-list-item-*); its own template supersedes the styled native select when built. Same status as Salt's dropdowns."
    },
    "structure.header": {
      "kind": "value",
      "value": true,
      "source": "date-picker-modal header tokens; owner reference screenshot: 'Select date' + 'Mon, Aug 17'"
    },
    "structure.input-toggle": {
      "kind": "value",
      "value": true,
      "source": "date-input-modal tokens; pencil icon toggles calendar <-> text entry"
    },
    "structure.actions": {
      "kind": "value",
      "value": true,
      "source": "modal Cancel/OK text buttons (owner screenshot)"
    },
    "structure.today-marker": {
      "kind": "off"
    },
    "behavior.selection-commit": {
      "kind": "value",
      "value": "confirm",
      "source": "M3 modal picker: selection pending until OK"
    },
    "behavior.range-selection": {
      "kind": "value",
      "value": false,
      "note": "docked/inline calendar has zero range tokens; range is a separate modal variant. Declared capability gap."
    },
    "prop.density": {
      "kind": "off",
      "note": "no global density; control renders locked"
    },
    "slot.weekday-format": {
      "kind": "value",
      "value": "narrow",
      "source": "owner screenshot + m3.material.io: S M T W T F S"
    },
    "slot.day-format": {
      "kind": "value",
      "value": "numeric"
    },
    "slot.outside-days": {
      "kind": "value",
      "value": "hidden",
      "source": "owner screenshot: leading cells empty, no adjacent-month dates"
    },
    "style.root.background": {
      "kind": "native",
      "token": "x-m3-surface-container-high",
      "source": "docked container-color"
    },
    "style.root.color": {
      "kind": "alias",
      "slot": "on-surface"
    },
    "style.root.padding": {
      "kind": "alias",
      "slot": "inset"
    },
    "style.root.shape": {
      "kind": "value",
      "value": "16px",
      "source": "docked container-shape corner-large (28px is the modal)"
    },
    "style.root.width": {
      "kind": "value",
      "value": "360px",
      "source": "docked container-width"
    },
    "style.day.size": {
      "kind": "alias",
      "slot": "control-size"
    },
    "style.day.cell-padding": {
      "kind": "value",
      "value": "4px",
      "source": "date-container 48px around 40px state layer"
    },
    "style.day.shape": {
      "kind": "value",
      "value": "999px",
      "source": "corner-full"
    },
    "style.day.font": {
      "kind": "alias",
      "slot": "type-body"
    },
    "style.day.background@hover": {
      "kind": "alias",
      "slot": "interaction-hover"
    },
    "style.day.selected": {
      "kind": "value",
      "value": {
        "background": "var(--action)",
        "color": "var(--on-action)"
      },
      "source": "date-selected-container primary / on-primary"
    },
    "style.day.range-middle": {
      "kind": "off"
    },
    "style.day.today": {
      "kind": "value",
      "value": {
        "outline": "1px solid var(--action)",
        "outline-offset": "-1px",
        "color": "var(--action)"
      },
      "source": "date-today-container-outline 1px primary; label primary"
    },
    "style.day.today-marker": {
      "kind": "off"
    },
    "style.day.outside": {
      "kind": "off",
      "note": "outside days hidden (config), no style needed"
    },
    "style.day.disabled": {
      "kind": "value",
      "value": {
        "color": "color-mix(in srgb, var(--on-surface) 38%, transparent)",
        "cursor": "var(--cursor-disabled)"
      },
      "source": "M3 disabled content 38% convention"
    },
    "style.day.focus": {
      "kind": "value",
      "value": {
        "background": "color-mix(in srgb, var(--x-m3-on-surface-variant) 12%, transparent)",
        "outline": "3px solid var(--focus)",
        "outline-offset": "2px"
      },
      "source": "focus-state-layer 0.12 + md-focus-ring defaults"
    },
    "style.nav.button.size": {
      "kind": "alias",
      "slot": "control-size",
      "source": "menu-button-container-height 40px"
    },
    "style.nav.button.shape": {
      "kind": "value",
      "value": "999px",
      "source": "menu-button corner-full"
    },
    "style.nav.button.background@hover": {
      "kind": "alias",
      "slot": "interaction-hover",
      "source": "menu-button-hover-state-layer 8%"
    },
    "style.caption.font": {
      "kind": "alias",
      "slot": "type-label",
      "source": "menu button label-large"
    },
    "style.dropdowns": {
      "kind": "off"
    },
    "style.weekday.font": {
      "kind": "alias",
      "slot": "type-body",
      "source": "weekdays-label-text body-large"
    },
    "style.weekday.color": {
      "kind": "alias",
      "slot": "on-surface",
      "source": "weekdays-label-text-color on-surface"
    },
    "style.header.label": {
      "kind": "value",
      "value": {
        "font": "var(--type-label)",
        "color": "var(--content-secondary)"
      },
      "source": "modal header supporting text label-large"
    },
    "style.header.headline": {
      "kind": "value",
      "value": {
        "font": "var(--type-headline)",
        "color": "var(--on-surface)"
      },
      "source": "headline-large 32/40"
    },
    "style.header.divider": {
      "kind": "off",
      "note": "divider color not in extracted docked tokens \u2014 omitted rather than guessed"
    },
    "style.actions.button": {
      "kind": "value",
      "value": {
        "font": "var(--type-label)",
        "color": "var(--action)",
        "background": "transparent",
        "border": "none",
        "padding": "10px 12px",
        "border-radius": "999px",
        "cursor": "var(--cursor-interactive)"
      },
      "source": "M3 text button: label-large, primary, full corner",
      "note": "COMPOSITION PLACEHOLDER: these are M3 text buttons \u2014 registry component 'button', template pending"
    },
    "slot.grid-weeks": {
      "kind": "value",
      "value": "variable",
      "source": "owner reference screenshot Aug 2025: grid ends at 31"
    },
    "style.day.range-start": {
      "kind": "off"
    },
    "style.day.range-end": {
      "kind": "off"
    },
    "style.day.today-marker@outside": {
      "kind": "off"
    },
    "prop.accent": {
      "kind": "off",
      "note": "no accent axis"
    },
    "style.day.range-middle-cell": {
      "kind": "off",
      "note": "no range mode"
    },
    "style.nav.layout": {
      "kind": "off",
      "note": "base flex layout suffices"
    },
    "style.caption.layout": {
      "kind": "off"
    },
    "style.nav.spacing": {
      "kind": "value",
      "value": {
        "margin-block-end": "4px"
      },
      "source": "docked spec: menu row sits close above weekdays; approximation pending full spec extraction",
      "note": "[R]-class value"
    },
    "style.header.spacing": {
      "kind": "value",
      "value": {
        "gap": "24px",
        "margin-block-end": "8px",
        "padding": "4px 8px 12px"
      },
      "source": "modal header region: label-to-headline 24dp per spec screenshots",
      "note": "[R]-class value \u2014 modal header paddings not in docked token file"
    },
    "style.actions.spacing": {
      "kind": "value",
      "value": {
        "gap": "8px",
        "margin-block-start": "8px"
      },
      "source": "M3 dialog action spacing 8dp convention",
      "note": "[R]-class value"
    }
  }
}
